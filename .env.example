# Copia este archivo como .env.local y rellena los valores.
# Panel de Supabase → Project Settings → API Keys.
# ¡No pongas valores reales en este archivo! Se sube a GitHub.

# URL del proyecto (no es secreta).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (sb_secret_...) o, en proyectos antiguos, la service_role.
# SOLO SERVIDOR: no le pongas nunca el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Opcional: esta aplicación no la usa (toda la lectura y escritura pasa por el
# servidor), pero es la que necesitarías para un cliente de navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
